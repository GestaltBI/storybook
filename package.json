{
  "name": "@gestaltbi/storybook",
  "version": "0.1.0",
  "description": "Interactive data narratives. Bind prose to analyses so a report explains itself from the data it runs on, and asserts the claims it makes.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepare": "npm run build",
    "prepack": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "@gestaltbi/stream": ">=0.1.0"
  },
  "devDependencies": {
    "@gestaltbi/stream": "github:GestaltBI/stream",
    "typescript": "~5.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GestaltBI/storybook.git"
  },
  "homepage": "https://github.com/GestaltBI/storybook",
  "bugs": "https://github.com/GestaltBI/storybook/issues",
  "keywords": ["narrative", "data-storytelling", "report", "analytics", "gestaltbi"]
}
